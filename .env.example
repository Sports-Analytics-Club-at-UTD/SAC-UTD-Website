# Copy this file to .env and fill in real values.
# .env should NEVER be committed — it's already in .gitignore.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Supabase or Neon) ---
# Supabase: Project Settings -> Database -> Connection string -> URI
#   Use the "Connection pooling" URI (port 6543) for the deployed app,
#   the direct URI (port 5432) for running migrations locally.
# Neon: Project -> Connection Details -> Connection string
#   Neon requires SSL — keep ?sslmode=require on the end of the URL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
DB_SSL_REQUIRED=True

# --- CORS (your frontend's origin, comma-separated for multiple) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (Secretary + Exec notifications) ---
# Leave EMAIL_BACKEND as the console backend for local dev — emails just
# print to your terminal instead of actually sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@sportsanalyticsclub.org
SECRETARY_EMAIL=secretary@sportsanalyticsclub.org
# Comma-separated list. Leave empty to disable Exec email notifications entirely.
EXEC_NOTIFICATION_EMAILS=
